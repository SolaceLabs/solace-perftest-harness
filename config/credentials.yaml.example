---
# Solace broker credentials for sdkperf
# Copy this file to credentials.yaml and fill in your values.
# credentials.yaml is gitignored and will not be committed.

broker_vpn: perftest-harness
broker_username: perftestharness
broker_password: default
sshuser: perfharness
ssh_port: 22               # SSH port on test hosts (default 22)
pub_cores: 4
sub_cores: 4
broker_tls: false          # Set to true to connect via TLS (tcps://) on port 55443
# broker_port:               # Override broker SMF port (optional; default: 55555 plaintext / 55443 TLS)

# ── SEMP management access (optional — pre-flight broker config checks) ───────
# Providing read-only SEMP credentials enables check-broker.sh to detect
# misconfigurations (ACL restrictions, disabled guaranteed messaging, etc.)
# before wasting test time. Leave absent or blank to disable.
# semp_host:                 # Management hostname/IP (e.g. 192.168.1.1 or mgmt.broker.example.com)
# semp_port: 8080            # HTTP port (default 8080 for software; 80 for appliances)
# semp_username: admin
# semp_password: admin
# semp_tls: false            # true = HTTPS

# ── Mesh throughput testing (VPN bridge / MNR / DMR) ──────────────────────────
# Publisher-side broker (messages enter here)
pub_broker:           ""        # IP/hostname; overridden by CLI arg if provided
pub_broker_vpn:       ""
pub_broker_username:  ""
pub_broker_password:  ""
pub_broker_tls:       false
# pub_broker_port:           # Override pub broker SMF port (optional; inherits broker_port if set)

# Subscriber-side broker (messages exit here after traversing the link)
sub_broker:           ""        # IP/hostname; overridden by CLI arg if provided
sub_broker_vpn:       ""
sub_broker_username:  ""
sub_broker_password:  ""
sub_broker_tls:       false
# sub_broker_port:           # Override sub broker SMF port (optional; inherits broker_port if set)

# ── Mesh SEMP management access (optional — per-side pre-flight checks) ───────
# pub_semp_host:             # Pub-side management host
# pub_semp_port: 8080
# pub_semp_username: admin
# pub_semp_password: admin
# pub_semp_tls: false
# sub_semp_host:             # Sub-side management host
# sub_semp_port: 8080
# sub_semp_username: admin
# sub_semp_password: admin
# sub_semp_tls: false
